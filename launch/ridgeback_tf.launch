<?xml version="1.0"?>

<!-- Track the Ridgeback base using Vicon -->
<launch>
  <arg name="use_joy_stick_relay" default="false" doc="use joy stick for emergency stop"/>
  <arg name="use_odom" default="false" doc="use odom velcoity for state estimation"/>

  <!-- Republish Vicon /ridgeback/cmd_vel to /ridgeback_velocity_controller/cmd_vel -->
  <node name="ridgeback_velocity_relay" pkg="topic_tools" type="relay" respawn="true" args="ridgeback/cmd_vel ridgeback_velocity_controller/cmd_vel" output="screen" unless="$(arg use_joy_stick_relay)"/>

  <!-- Estimation of Ridgeback joint state from tf messages. -->
  <node pkg="mobile_manipulation_central" type="ridgeback_tf_estimator_node" name="ridgeback_tf_estimator_node" required="true" output="screen" unless="$(arg use_odom)">
    <param name="target_frame_id" value="base_link"/>
    <param name="source_frame_id" value="world"/>
    <param name="tau_linear" value="0.045"/>
    <param name="tau_angular" value="0.025"/>
    <param name="update_rate" value="50"/>
  </node>
  <!-- Estimation of Ridgeback joint state from tf and odom messages. -->
  <node pkg="mobile_manipulation_central" type="ridgeback_tf_odom_estimator_node" name="ridgeback_tf_odom_estimator_node" required="true" output="screen" if="$(arg use_odom)">
    <param name="target_frame_id" value="base_link"/>
    <param name="source_frame_id" value="my_world"/>
  </node>
</launch>
